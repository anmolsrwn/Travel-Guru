# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API — for live reviews (server-only)
# Enable "Places API (New)" in Google Cloud Console, then create an API key.
# Find your Place ID at: https://developers.google.com/maps/documentation/javascript/place-id
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_place_id_here

# Quote email notifications (server-only). Uses SMTP via nodemailer.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=a Google "App password" (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional: defaults to SMTP_USER / BUSINESS.email in lib/data.js
SMTP_FROM=
QUOTE_NOTIFY_TO=
